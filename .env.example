DATABASE_URL=postgres://suftrip:development-only@localhost:5432/suftrip
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
PORT=3000
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_MS=60000
NOTIFICATION_WORKER_ID=notification-worker-local
NOTIFICATION_WORKER_BATCH_SIZE=20
NOTIFICATION_WORKER_LEASE_MS=30000
NOTIFICATION_WORKER_MAX_ATTEMPTS=5
NOTIFICATION_WORKER_POLL_INTERVAL_MS=1000
