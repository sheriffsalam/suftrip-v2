{
  "name": "suftrip-v2",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Suftrip V2 modular monolith",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "start": "node dist/src/http/server.js",
    "start:outbox": "node dist/src/infrastructure/outbox/run-outbox-worker.js",
    "start:notifications": "node dist/src/infrastructure/notifications/run-notification-delivery-worker.js",
    "db:migrate": "npm run build && node dist/src/infrastructure/persistence/postgres/migrate.js",
    "db:migrate:runtime": "node dist/src/infrastructure/persistence/postgres/migrate.js"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "pg": "^8.23.0"
  }
}
